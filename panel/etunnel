  echo -e "${CYAN}  ${YELLOW}[1]${NC} Set speed limit   ${YELLOW}[2]${NC} Remove limit   ${YELLOW}[0]${NC} Back"
  read -p "  Choice: " SLC < /dev/tty
  case $SLC in
   1)
